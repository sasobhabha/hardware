#!/bin/busybox sh
# RAM-only iPhone 5S recovery. No block device or NAND is opened.
set -eu
export PATH=/bin:/sbin:/usr/bin:/usr/sbin
cd /
/bin/busybox --install -s
mount -t proc -o nodev,noexec,nosuid proc /proc
mount -t sysfs -o nodev,noexec,nosuid sysfs /sys
mount -t devtmpfs -o mode=0755,nosuid dev /dev
mount -t tmpfs -o mode=0755,nosuid,nodev tmpfs /run
mkdir -p /dev/pts /run/recovery
mount -t devpts -o mode=0620,ptmxmode=0666 devpts /dev/pts
exec </dev/console >/dev/console 2>&1

board=$(tr '\000' '\n' < /proc/device-tree/compatible | head -1)
case "$board" in
    apple,n51|apple,n53) ;;
    *)
        echo "Wrong device for iPhone 5S recovery: ${board}"
        exec sh
        ;;
esac
echo "iPhone 5S RAM recovery (${board}). Storage is not mounted."

set +e
/sbin/recovery-usb
usb_status=$?
set -e
if [ "$usb_status" -eq 0 ]; then
    set +e
    ip address add 172.16.42.1/30 dev usb0
    ip link set usb0 up
    udhcpd -f /etc/udhcpd.conf &
    (
        while getty -n -l /bin/sh ttyGS0 115200 vt100; do sleep 1; done
    ) &
    set -e
    echo 'USB serial on ttyGS0; device 172.16.42.1, host 172.16.42.2'
else
    echo 'USB gadget did not start. The screen shell is still available.'
fi
(
    while getty -n -l /bin/sh tty0 115200 vt100; do sleep 1; done
) &
while true; do sleep 3600; done
